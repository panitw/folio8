{
  "name": "folio8",
  "version": "1.0.0",
  "description": "folio8 for Node: render and validate .folio templates with the folio8 engine compiled to WebAssembly. Design templates at https://folio8.report.",
  "license": "MIT",
  "author": "Panit Wechasil",
  "homepage": "https://folio8.report",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panitw/folio8.git",
    "directory": "folio-js"
  },
  "bugs": {
    "url": "https://github.com/panitw/folio8/issues"
  },
  "keywords": [
    "pdf",
    "report",
    "reporting",
    "template",
    "folio8",
    "deterministic",
    "wasm"
  ],
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12"
  },
  "folio8EngineVersion": "1.0.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fonts": {
      "types": "./dist/fonts.d.ts",
      "default": "./dist/fonts.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "wasm",
    "fonts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:fonts": "node scripts/build-fonts.mjs",
    "build": "npm run build:wasm && npm run build:fonts && tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "oxlint && tsc -p tsconfig.test.json --noEmit",
    "prepack": "npm run build && node scripts/package-check.mjs"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "oxlint": "1.79.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
