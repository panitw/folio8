{
  "assets": {},
  "bands": {
    "content": {
      "elements": [
        {
          "id": "e1", "type": "table", "x": 0, "y": 0,
          "bind": "account.transactions[]", "as": "txn", "headerHeight": 24,
          "columns": [
            {"id": "e2", "label": "Sum", "width": 72, "bind": "{{txn.amount}}", "footer": "sum", "footerOf": "account.transactions.totals.net", "footerFormat": "#,##0.00"},
            {"id": "e3", "label": "Average", "width": 72, "bind": "{{formatNumber(txn.amount, \"0.00\")}}", "footer": "avg", "footerOf": "account.transactions.fees.tax", "footerFormat": "0.00"},
            {"id": "e4", "label": "Derived", "width": 72, "bind": "{{txn.amount}}", "footer": "sum", "footerFormat": "0.00"},
            {"id": "e5", "label": "Count", "width": 72, "bind": "{{txn.code}}", "footer": "count"},
            {"id": "e6", "label": "Plain", "width": 72, "bind": "{{account.name}}"}
          ]
        }
      ]
    },
    "pageFooter": {"elements": [], "height": 20},
    "pageHeader": {"elements": [], "height": 20}
  },
  "fonts": {"body": ["Noto Sans"]},
  "locale": "en",
  "nextId": 7,
  "page": {"margin": {"bottom": 36, "left": 36, "right": 36, "top": 36}, "orientation": "portrait", "size": "A4"},
  "utcOffset": "+00:00",
  "version": "1.0"
}
