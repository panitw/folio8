<Project Sdk="Microsoft.NET.Sdk">

  <!--
    netstandard2.0, and nothing newer, is the whole point: it is the widest
    target .NET Framework and modern .NET consume from ONE build, and the
    4.6 floor bans the modern toolkit (Span<T>, System.Text.Json,
    NativeLibrary, DllImportResolver, nullable reference types). The binding
    is therefore plain DllImport marshalling.

    LangVersion is pinned to 7.3 — the last version that does not depend on
    runtime support this target may not have — so a modern construct is a
    COMPILER ERROR here rather than a surprise on a customer's .NET Framework
    4.6 machine. test/Folio8.Net46Compile proves the floor a second way, by
    compiling these same sources against 4.6 reference assemblies.

    No PackageReference. Ever: a third-party runtime dependency on this
    assembly is out of scope by decision, not by accident. That is also why
    the package below declares no dependency group content of its own —
    `dotnet add package folio8` brings exactly one assembly, two native
    libraries and eleven font faces, and nothing else.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>Folio8</AssemblyName>
    <!--
      EMPTY ON PURPOSE. The public types sit in the GLOBAL namespace so a call
      site reads as `Folio8.Render(...)`; a namespace named Folio8 would make
      that spelling unreachable, because C# resolves the simple name to the
      namespace and never finds the class inside it. RootNamespace is what the
      SDK hands to generators and to new files, so leaving it as `Folio8`
      would drop the next generated file into the one namespace this design
      forbids.
    -->
    <RootNamespace></RootNamespace>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
  </PropertyGroup>

  <!--
    PACKAGE IDENTITY.

    The id is `folio8` while the assembly stays `Folio8.dll`: the package is
    how you install it, the assembly is what the call site names. The
    repository directory keeps its own name, `folio-dotnet/`, which is also
    what the release tag is prefixed with (AD-22). Version 1.0.0 is this
    package's OWN release line, independent of the engine's; what ties them
    together is FolioEngineVersion below.

    Nothing here publishes. No script, target or workflow in this repository
    pushes this package to a registry — RELEASING.md's NuGet section is the
    only procedure, and it is typed by the owner, with the owner's own key.
    PackagingTests greps every tracked script for that command and reddens if
    one acquires it.
  -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>folio8</PackageId>
    <Version>1.2.0</Version>
    <Authors>Panit Wechasil</Authors>
    <Company>Panit Wechasil</Company>
    <Product>folio8</Product>
    <Copyright>Copyright (c) folio8 contributors</Copyright>
    <!--
      THE LISTING TEXT NAMES ONLY WHAT THIS PACK ACTUALLY CONTAINS, so it is
      conditioned on the SAME property the FolioNative items are. A
      -p:FolioPackPlatforms=windows pack drops the two Linux items below; a
      nupkg that advertised linux-x64 and linux-arm64 it does not carry would
      freeze that claim into the NuGet listing, where nothing can redden for
      it afterwards.
    -->
    <Description Condition="'$(FolioPackPlatforms)' == 'windows'">folio8 for .NET: render and validate .folio templates with the folio8 engine as a native library. Byte-identical to the Go engine, from .NET Framework 4.6 through modern .NET, on Windows x86 and x64. Ships both Windows native architectures and the eleven shipped font faces. Design templates at https://folio8.report.</Description>
    <Description Condition="'$(FolioPackPlatforms)' != 'windows'">folio8 for .NET: render and validate .folio templates with the folio8 engine as a native library. Byte-identical to the Go engine, from .NET Framework 4.6 through modern .NET, on Windows x86 and x64 and on Linux x64 and arm64 (glibc 2.28 or newer; musl is not supported). Ships all four native architectures and the eleven shipped font faces. Design templates at https://folio8.report.</Description>
    <PackageTags>pdf;reporting;folio8;rendering;documents;invoice;statement</PackageTags>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://folio8.report</PackageProjectUrl>
    <RepositoryUrl>https://github.com/panitw/folio8.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <!--
      THE ENGINE VERSION THIS PACKAGE BINDS, recorded as assembly metadata —
      the npm package's `folio8EngineVersion` in package.json, in the spelling .NET
      has for the same job. It is NOT the package version and must not track
      it: the two are separate release lines. PackagingTests asserts this
      equals what the loaded native library reports AND what the Go engine
      recorded into folio-js/test/data/go-parity.json, so the three cannot
      drift apart silently.
    -->
    <FolioEngineVersion>1.2.0</FolioEngineVersion>
    <!-- No symbol or source-link package: a native-backed binding's symbols
         say nothing useful about the half that does the work. -->
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="folio8EngineVersion" Value="$(FolioEngineVersion)" />
  </ItemGroup>

  <PropertyGroup>
    <FolioRepoRoot>$(MSBuildThisFileDirectory)../../../</FolioRepoRoot>
    <FolioGoFonts>$(FolioRepoRoot)folio-go/fonts</FolioGoFonts>
    <FolioNativeDir>$(MSBuildThisFileDirectory)../../build/native</FolioNativeDir>
    <FolioParityJson>$(FolioRepoRoot)folio-js/test/data/go-parity.json</FolioParityJson>
  </PropertyGroup>

  <!--
    THE ELEVEN FACES, EMBEDDED STRAIGHT FROM folio-go/fonts/.

    They are read from the engine's own tree at build time and never copied
    into folio-dotnet/, let alone committed there: folio-go/fonts/ is the one
    source of truth (the engine embeds the same files), and a second tracked
    14 MB copy could diverge silently. LogicalName is what Fonts.cs asks for,
    so the resource names do not depend on RootNamespace — which is
    deliberately empty here.

    EMBEDDED, NOT SHIPPED BESIDE. It is the one asset that has to reach both
    target families, and .NET Framework and modern .NET disagree about every
    file-delivery mechanism NuGet has. A resource inside the assembly is just
    there. Fonts.cs records the rest of the reasoning.
  -->
  <ItemGroup>
    <FolioShippedFace Include="$(FolioGoFonts)/notosans/NotoSans-Regular.ttf"><FaceName>Noto Sans</FaceName></FolioShippedFace>
    <FolioShippedFace Include="$(FolioGoFonts)/notosans-bold/NotoSans-Bold.ttf"><FaceName>Noto Sans Bold</FaceName></FolioShippedFace>
    <FolioShippedFace Include="$(FolioGoFonts)/notosans-italic/NotoSans-Italic.ttf"><FaceName>Noto Sans Italic</FaceName></FolioShippedFace>
    <FolioShippedFace Include="$(FolioGoFonts)/notosans-bolditalic/NotoSans-BoldItalic.ttf"><FaceName>Noto Sans Bold Italic</FaceName></FolioShippedFace>
    <FolioShippedFace Include="$(FolioGoFonts)/notosansthai/NotoSansThai-Regular.ttf"><FaceName>Noto Sans Thai</FaceName></FolioShippedFace>
    <FolioShippedFace Include="$(FolioGoFonts)/notosansthai-bold/NotoSansThai-Bold.ttf"><FaceName>Noto Sans Thai Bold</FaceName></FolioShippedFace>
    <FolioShippedFace Include="$(FolioGoFonts)/notosanssc/NotoSansSC-Regular.ttf"><FaceName>Noto Sans SC</FaceName></FolioShippedFace>
    <FolioShippedFace Include="$(FolioGoFonts)/roboto/Roboto-Regular.ttf"><FaceName>Roboto</FaceName></FolioShippedFace>
    <FolioShippedFace Include="$(FolioGoFonts)/roboto-bold/Roboto-Bold.ttf"><FaceName>Roboto Bold</FaceName></FolioShippedFace>
    <FolioShippedFace Include="$(FolioGoFonts)/roboto-italic/Roboto-Italic.ttf"><FaceName>Roboto Italic</FaceName></FolioShippedFace>
    <FolioShippedFace Include="$(FolioGoFonts)/roboto-bolditalic/Roboto-BoldItalic.ttf"><FaceName>Roboto Bold Italic</FaceName></FolioShippedFace>

    <EmbeddedResource Include="@(FolioShippedFace)">
      <LogicalName>folio8.fonts.%(Filename)%(Extension)</LogicalName>
      <Visible>false</Visible>
    </EmbeddedResource>
  </ItemGroup>

  <!--
    THE FOUR SHIPPED NATIVES, in the RID layout modern .NET resolves natively.
    build/build-native.{sh,ps1} produce them; they are never committed.

    WINDOWS NEEDS BOTH BITNESSES because a .NET Framework project is AnyCPU
    and chooses at load time (see folio-dotnet.targets). LINUX NEEDS BOTH
    ARCHITECTURES because ARM servers and containers are ordinary now; the
    host resolves the RID, so nothing chooses at load time there.

    NO linux-musl-x64, DELIBERATELY. Go's -buildmode=c-shared emits
    initial-exec TLS relocations that musl's loader refuses under dlopen —
    which is how P/Invoke loads this library — so an Alpine consumer gets
    "initial-exec TLS resolves to dynamic definition" at the first render.
    Building the native WITH musl does not fix it; it is a property of the
    Go build mode, measured on x86-64 and arm64 alike. Shipping the RID
    anyway would convert a clean install-time absence into a runtime crash,
    so Alpine is documented as unsupported instead. Note that
    linux-musl-x64 does NOT inherit linux-x64 assets in the RID graph, so an
    Alpine consumer resolves no native from this package at all.
  -->
  <ItemGroup>
    <FolioNative Include="$(FolioNativeDir)/win-x64/folio8_native.dll"><Rid>win-x64</Rid></FolioNative>
    <FolioNative Include="$(FolioNativeDir)/win-x86/folio8_native.dll"><Rid>win-x86</Rid></FolioNative>
    <FolioNative Include="$(FolioNativeDir)/linux-x64/libfolio8_native.so" Condition="'$(FolioPackPlatforms)' != 'windows'"><Rid>linux-x64</Rid></FolioNative>
    <FolioNative Include="$(FolioNativeDir)/linux-arm64/libfolio8_native.so" Condition="'$(FolioPackPlatforms)' != 'windows'"><Rid>linux-arm64</Rid></FolioNative>

    <!--
      THE TWO LINUX RIDs, RESTORED. They were BUILT, VERIFIED AND PACKED for
      1.1.0 and then WITHDRAWN FROM THE PACKAGE before it shipped, and this
      comment is the record of why — so that it is never re-litigated from
      memory, and so that a future reader understands that these two lines
      carry history rather than being an ordinary addition.

      WHY THEY WERE OUT (DW-396). Entering the engine from a CLR thread-pool
      thread ran Go's SA_ONSTACK signal handlers on that thread's alternate
      signal stack, which is too small for them: the CLR installs a FIXED
      16 KiB (amd64) / 24 KiB (arm64) altstack on every thread it touches,
      and Go under cgo ADOPTS an existing altstack rather than installing its
      own 32 KiB. The kernel reported `.NET TP Worker overflowed sigaltstack`
      and converted the overflow into SIGSEGV, which the CLR surfaced as
      `Internal CLR error (0x80131506)`. It was nondeterministic, had no
      consumer-side mitigation, and killed the host process.

      IT WAS NEVER THE BUILD IMAGE. That was the first reading — the
      AlmaLinux 8 native went 11 runs clean on CI while the runner-built one
      crashed — and it was wrong: the same native overflowed once it was run
      enough times. The build's glibc moves the FREQUENCY, not the defect,
      because glibc 2.34 turned SIGSTKSZ into a runtime value.

      WHAT CHANGED. The binding no longer crosses the ABI on arbitrary CLR
      threads. Every crossing — folio8_free included — is routed onto a pool
      of long-lived binding-owned engine threads whose alternate signal stacks
      the binding enlarges with sigaltstack() before their first crossing, so
      the stack Go adopts is one the binding sized. That is the change these
      two lines depend on; without it, restoring them reproduces DW-396
      exactly.

      NO linux-musl-x64, AND THAT IS NOT A DEFERRAL. See the note above.

      THE SOAK IS NOT THE SAME THING AS THE FIX. Restoring these items makes
      the repository ready; it does not make the package shippable. Packing a
      Linux RID is gated on an explicit human assertion that CAP-5's soak has
      passed on real hardware — see FolioAssertLinuxSoak below.

      -p:FolioPackPlatforms=windows DROPS THE TWO LINUX ITEMS, and it is for
      the .NET Framework consumer harness, which runs on a Windows runner that
      has no libfolio8_native.so to pack and is asking a Windows-only
      question. It is NOT a release mode and NOT a way past the gate: with no
      Linux RID there is nothing to soak, and with no Linux native in the
      package there is nothing to ship. A release pack passes the assertion
      instead. PackagingTests enumerates every tracked `dotnet pack` of this
      project and holds each one to that choice.
    -->

    <None Include="@(FolioNative)" Pack="true" PackagePath="runtimes/%(Rid)/native/" Visible="false" />
  </ItemGroup>

  <!--
    THE .NET FRAMEWORK DELIVERY. `runtimes/` is a modern-.NET mechanism: a
    .NET Framework project's build does nothing with it, so a 4.6 consumer
    would install this package and still have no native library beside its
    exe. These targets, which NuGet imports automatically because the file is
    named for the package id, stage BOTH architectures into
    folio8-native/<rid>/ next to the output — and NativeLibraryLoader picks
    the one that matches the process at load time. The consumer authors
    nothing.
  -->
  <ItemGroup>
    <None Include="../../build/folio-dotnet.targets" Pack="true" PackagePath="build/folio8.targets" Visible="false" />
    <None Include="../../build/folio-dotnet.targets" Pack="true" PackagePath="buildTransitive/folio8.targets" Visible="false" />
  </ItemGroup>

  <!--
    README and LICENCE travel in the package: a package installed from a
    registry carries no repository around it. AD-26 — the licence census
    pins folio-dotnet/LICENSE the way it pins folio-js/LICENSE.

    The FACE licences and notices go in beside them, under
    third-party-notices/, copied at build time from folio-go/fonts/ like the
    faces themselves. A directory holding a font binary ships its own terms;
    here the binaries are inside the assembly, so the terms ship next to it.
  -->
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="" Visible="false" />
    <None Include="../../LICENSE" Pack="true" PackagePath="" Visible="false" />
    <None Include="$(FolioGoFonts)/**/LICENSE-OFL.txt" Pack="true" PackagePath="third-party-notices/fonts/" Visible="false" />
    <None Include="$(FolioGoFonts)/**/NOTICE.md" Pack="true" PackagePath="third-party-notices/fonts/" Visible="false" />
  </ItemGroup>

  <!--
    PACKING CANNOT SHIP AN INCOMPLETE PACKAGE.

    An inline task, run before the nuspec is generated, that refuses the pack
    — naming exactly what is wrong — when a native is missing, a native is
    built for the wrong architecture, a face is missing or has drifted from
    the byte length the Go engine itself recorded, or the set is not the
    eleven faces fonts.Shipped() returns. It reads the PE header of each DLL
    rather than trusting the directory it came out of: a win-x86 folder
    holding the x64 build is exactly the mistake that produces
    BadImageFormatException on a customer's machine, and it is invisible to
    every other check.
  -->
  <UsingTask TaskName="FolioPackageCheck" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Faces ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <Natives ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <ParityJson ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        if (!File.Exists(ParityJson))
        {
          Log.LogError("folio8 pack: the fonts.Shipped() record is missing at " + ParityJson + ", so no face can be checked for drift.");
          return false;
        }
        // SCOPED TO shippedFaces, AND ORDER-INDEPENDENT. A regexp over the
        // whole file that also required "name" and "byteLength" to be adjacent
        // and in that order would silently record ZERO faces after any
        // reformat of go-parity.json — turning a gate into a rubber stamp, and
        // one that reports "0 faces" rather than "the check broke".
        string parity = File.ReadAllText(ParityJson);
        int arrayAt = parity.IndexOf("\"shippedFaces\"", StringComparison.Ordinal);
        arrayAt = arrayAt < 0 ? -1 : parity.IndexOf('[', arrayAt);
        int arrayEnd = arrayAt < 0 ? -1 : parity.IndexOf(']', arrayAt);
        if (arrayEnd < 0)
        {
          Log.LogError("folio8 pack: " + ParityJson + " has no shippedFaces array, so no face can be checked for drift.");
          return false;
        }
        var recorded = new Dictionary<string, long>(StringComparer.Ordinal);
        foreach (Match entry in Regex.Matches(parity.Substring(arrayAt, arrayEnd - arrayAt + 1), "\\{[^{}]*\\}"))
        {
          Match name = Regex.Match(entry.Value, "\"name\"\\s*:\\s*\"([^\"]+)\"");
          Match length = Regex.Match(entry.Value, "\"byteLength\"\\s*:\\s*(\\d+)");
          if (!name.Success || !length.Success)
          {
            Log.LogError("folio8 pack: a shippedFaces entry in " + ParityJson + " has no name or no byteLength: " + entry.Value);
            continue;
          }
          recorded[name.Groups[1].Value] = long.Parse(length.Groups[1].Value);
        }
        if (recorded.Count != 11)
        {
          Log.LogError("folio8 pack: " + ParityJson + " records " + recorded.Count + " shipped faces; fonts.Shipped() ships eleven. Refusing to pack a font set that cannot be checked.");
        }
        if (Faces.Length != 11)
        {
          Log.LogError("folio8 pack: this project embeds " + Faces.Length + " faces; fonts.Shipped() ships eleven. The package must carry the engine's whole set.");
        }
        foreach (var face in Faces)
        {
          string name = face.GetMetadata("FaceName");
          string path = face.GetMetadata("FullPath");
          if (!File.Exists(path))
          {
            Log.LogError("folio8 pack: the face '" + name + "' is missing from the engine's tree at " + path + ".");
            continue;
          }
          long actual = new FileInfo(path).Length;
          long want;
          if (!recorded.TryGetValue(name, out want))
          {
            Log.LogError("folio8 pack: the face '" + name + "' is not in " + ParityJson + "'s shippedFaces — fonts.Shipped() does not ship it.");
            continue;
          }
          if (actual != want)
          {
            Log.LogError("folio8 pack: the face '" + name + "' is " + actual + " bytes at " + path + ", but fonts.Shipped() records " + want + ". The embedded set has drifted from the engine's.");
          }
        }
        foreach (var native in Natives)
        {
          string rid = native.GetMetadata("Rid");
          string path = native.GetMetadata("FullPath");
          if (!File.Exists(path))
          {
            Log.LogError("folio8 pack: the " + rid + " native library is missing at " + path + ". Run folio-dotnet/build/build-native.sh linux-x64 linux-arm64 and build-native.ps1 win-x64 win-x86 before packing; a package missing a platform makes DllNotFoundException (or BadImageFormatException) the normal first experience on it.");
            continue;
          }
          // WINDOWS IS PE, LINUX IS ELF, and the check reads whichever the RID
          // says it should be rather than sniffing. Reading the header is the
          // point: a linux-arm64 folder holding the x64 build, or a win-x86
          // folder holding the x64 DLL, is exactly the mistake that reaches a
          // customer as a load failure and is invisible to every other check.
          bool isWindows = rid.StartsWith("win-", StringComparison.Ordinal);
          int machine = -1;
          using (var stream = new FileStream(path, FileMode.Open, FileAccess.Read))
          using (var reader = new BinaryReader(stream))
          {
            if (isWindows)
            {
              if (stream.Length > 0x40)
              {
                stream.Position = 0x3C;
                long headerAt = reader.ReadUInt32();
                if (headerAt > 0 && headerAt + 6 <= stream.Length)
                {
                  stream.Position = headerAt;
                  if (reader.ReadUInt32() == 0x00004550u) { machine = reader.ReadUInt16(); }
                }
              }
            }
            else
            {
              // ELF: magic 0x7F 'E' 'L' 'F', then e_type at 0x10 and
              // e_machine at 0x12, both little-endian on every target here.
              // ET_DYN (3) is asserted too: a shared object, not an
              // executable or a relocatable .o someone renamed.
              if (stream.Length > 0x14)
              {
                if (reader.ReadUInt32() == 0x464C457Fu)
                {
                  stream.Position = 0x10;
                  int type = reader.ReadUInt16();
                  int m = reader.ReadUInt16();
                  if (type == 3) { machine = m; }
                  else
                  {
                    Log.LogError("folio8 pack: " + path + " is an ELF file of type " + type + ", not a shared object (ET_DYN = 3), so it cannot be the " + rid + " native library.");
                    continue;
                  }
                }
              }
            }
          }
          int wanted;
          if (rid == "win-x64") { wanted = 0x8664; }
          else if (rid == "win-x86") { wanted = 0x014C; }
          else if (rid == "linux-x64") { wanted = 0x003E; }
          else if (rid == "linux-arm64") { wanted = 0x00B7; }
          else
          {
            Log.LogError("folio8 pack: no architecture is known for the RID '" + rid + "'. Add it here when the RID is added to FolioNative, or the native ships unchecked.");
            continue;
          }
          if (machine < 0)
          {
            Log.LogError("folio8 pack: " + path + " is not a " + (isWindows ? "Windows PE" : "Linux ELF") + " file, so it cannot be the " + rid + " native library.");
          }
          else if (machine != wanted)
          {
            Log.LogError("folio8 pack: " + path + " has " + (isWindows ? "PE" : "ELF") + " machine 0x" + machine.ToString("X4") + ", but " + rid + " needs 0x" + wanted.ToString("X4") + ". Two architectures have been swapped or one was built twice.");
          }
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <!--
    PACKING A LINUX RID IS A DELIBERATE ACT, NOT A DEFAULT.

    This gate is an ADDITION the withdrawal never needed, and it exists for
    one reason: the evidence that authorises shipping Linux does not exist
    yet. CAP-5's two hardware legs — real amd64 and real arm64, neither
    standing in for the other, no emulation and no Rosetta — are PENDING in
    _bmad-output/implementation-artifacts/dotnet-linux-soak.md.

    Without a gate, `dotnet pack` would be one command away from producing
    exactly the package 1.1.0 withdrew, and the reason it was withdrawn would
    be a COMMENT rather than a REFUSAL. DW-396's own history is that a run of
    passes was read as a clear; a comment is weaker than that.

    So the opt-in is not a boolean and not a bare `true`: the person packing
    types the CLAIM THEY ARE MAKING, word for word, at the moment they make
    it. It is never set in this file, in a script, in a Directory.Build.props
    or in CI — if it ever is, this gate has become a rubber stamp and should
    be read as broken.

        dotnet pack folio-dotnet/src/Folio8/Folio8.csproj -c Release \
          -p:FolioLinuxSoakEvidence="CAP-5 soaked on real amd64 and real arm64"

    The gate arms off the packed RIDs, so -p:FolioPackPlatforms=windows — the
    Windows-only pack the .NET Framework consumer harness uses — disarms it on
    purpose: a package with no Linux native in it has nothing to soak.
    PackagingTests holds every half of this: that the four RIDs are packed,
    that the gate refuses a real `dotnet pack` without the assertion, that no
    tracked file supplies the assertion, and that every tracked `dotnet pack`
    of this project is compatible with the gate.
  -->
  <Target Name="FolioAssertLinuxSoak" BeforeTargets="GenerateNuspec">
    <ItemGroup>
      <FolioLinuxNative Include="@(FolioNative)" Condition="$([System.String]::Copy('%(FolioNative.Rid)').StartsWith('linux'))" />
    </ItemGroup>
    <!--
      THE EXPECTED VALUE IS A LITERAL, NOT A PROPERTY. It was a property once,
      and that was a hole: MSBuild global properties override everything, so
      `-p:FolioLinuxSoakAssertion=` with no evidence made both sides empty and
      the condition false — the gate opened with nothing typed. CompareOrdinal
      rather than `!=` because MSBuild's string comparison is CASE-INSENSITIVE
      and the claim above is one a human types word for word.
    -->
    <Error
      Condition="'@(FolioLinuxNative)' != '' AND $([System.String]::CompareOrdinal('$(FolioLinuxSoakEvidence)', 'CAP-5 soaked on real amd64 and real arm64')) != 0"
      Text="folio8 pack: REFUSING to pack the Linux RIDs (@(FolioLinuxNative->'%(Rid)', ', ')) because CAP-5's soak has not been asserted. The two hardware legs are recorded PENDING in _bmad-output/implementation-artifacts/dotnet-linux-soak.md; run folio-dotnet/build/soak.sh --reproduce and then folio-dotnet/build/soak.sh --iterations 100 on REAL amd64 and on REAL arm64 separately (the runner refuses translated hosts, Rosetta included), record both legs there, and only then pack with -p:FolioLinuxSoakEvidence=&quot;CAP-5 soaked on real amd64 and real arm64&quot;. Asserting this without those legs is the false clear DW-396 already records being made twice. (A Windows-only pack — -p:FolioPackPlatforms=windows — needs no assertion, because it ships no Linux native.)" />
    <!--
      AND IT WILL NOT TAKE THE ASSERTION FROM THE ENVIRONMENT. MSBuild reads
      environment variables as properties, so `export FolioLinuxSoakEvidence=…`
      in a shell profile or a CI `env:` block would open this gate invisibly —
      in the one place the tracked-file sweep in PackagingTests cannot look.
      The whole design is that a human types the claim at the moment they pack,
      so an assertion that was sitting in the environment beforehand is exactly
      the thing being refused.
    -->
    <Error
      Condition="'@(FolioLinuxNative)' != '' AND '$([System.Environment]::GetEnvironmentVariable(`FolioLinuxSoakEvidence`))' != ''"
      Text="folio8 pack: the CAP-5 soak assertion arrived in the ENVIRONMENT (FolioLinuxSoakEvidence is exported). Unset it and pass it on the command line instead: an assertion a shell profile or a CI env block makes on your behalf is not an assertion." />
  </Target>

