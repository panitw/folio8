<?xml version="1.0" encoding="utf-8"?>
<!--
  Runs the test host 32-BIT, against the win-x86 DLL.

  This is the leg that actually executes the calling-convention decision. cgo
  exports are cdecl; .NET's DllImport default is stdcall on Windows. On x64
  there is only one convention and the mismatch is invisible — so an x64-only
  suite would pass with the attribute removed. On x86 it corrupts the stack,
  and x86 is the .NET Framework 4.6 floor this library exists to reach.

  BOTH TARGET FAMILIES USE THIS FILE (story 8). It was net48 only for a
  while, because actions/setup-dotnet installs no 32-bit modern .NET runtime
  and there was therefore no x86 host for net10.0 to run in. CAP-5's axes are
  {net48, modern} x {64-bit, 32-bit} and a corner proved by inference is not
  proved, so ci.yml now installs the x86 runtime explicitly and runs the
  corpus through this file on both frameworks.
-->
<RunSettings>
  <RunConfiguration>
    <TargetPlatform>x86</TargetPlatform>
  </RunConfiguration>
</RunSettings>
