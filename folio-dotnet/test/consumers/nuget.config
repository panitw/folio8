<?xml version="1.0" encoding="utf-8"?>
<!--
  The consumer projects restore folio-dotnet from a LOCAL FEED that
  run-consumers.ps1 fills by running `dotnet pack`. The path is relative to
  this file, so it works from any working directory and on any runner.

  PACKAGE SOURCE MAPPING IS WHAT MAKES THIS MEASURE ANYTHING. nuget.org has to
  stay in the list — a self-contained win-x86 publish pulls the .NET runtime
  pack from it — but with both sources present, a `folio-dotnet` that one day
  exists on the registry could satisfy the restore and the whole consumer
  suite would then be testing a published package instead of the one this
  commit just built. The mapping below routes that one id to the local feed
  and nothing else, so a missing local package fails the restore rather than
  quietly resolving elsewhere.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="folio-local" value="../../../artifacts/nupkg" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="folio-local">
      <package pattern="folio8" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
