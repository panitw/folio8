{
  "version": 1,
  "scope": "Reference static-host contract; folio8 does not operate a host.",
  "immutableRuntime": {
    "urlPrefix": "/assets/",
    "sidecarSuffix": ".br",
    "contentEncoding": "br",
    "cacheControl": "public, max-age=31536000, immutable, no-transform"
  },
  "updateableEntries": [
    { "url": "/index.html", "cacheControl": "no-cache, no-transform" },
    { "url": "/sw.js", "cacheControl": "no-cache, no-transform" }
  ]
}
