              "label": "Description",
              "proportion": 4.4
            },
            {
              "align": "right",
              "bind": "{{txn.debit != null ? formatNumber(txn.debit, \"#,##0.00\") : \"\"}}",
              "id": "ei",
              "label": "Debit",
              "proportion": 1.4
            },
            {
              "align": "right",
              "bind": "{{txn.credit != null ? formatNumber(txn.credit, \"#,##0.00\") : \"\"}}",
              "id": "ej",
