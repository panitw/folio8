        },
        {
          "as": "item",
          "bind": "items[]",
          "columns": [
            {
              "align": "left",
              "bind": "{{item.description}}",
              "id": "ea",
              "label": "Description",
              "proportion": 5
            },
            {
              "align": "right",
              "bind": "{{item.qty}}",
              "id": "eb",
              "label": "Qty",
              "proportion": 1
            },
            {
              "align": "right",
              "bind": "{{formatNumber(item.unitPrice, \"#,##0.00\")}}",
              "id": "ec",
              "label": "Unit price",
              "proportion": 1.5
            },
            {
              "align": "right",
              "bind": "{{formatNumber(item.amount, \"#,##0.00\")}}",
              "footer": "sum",
              "id": "ed",
              "label": "Amount",
              "proportion": 1.5
            }
